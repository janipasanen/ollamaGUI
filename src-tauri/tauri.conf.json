{
  "$schema": "https://tauri.app/v1/schema.json",
  "package": {
    "version": "0.1.0",
    "productName": "OllamaGUI"
  },
  "tauri": {
    "windows": [
      {
        "label": "main",
        "title": "OllamaGUI",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "focus": true
      }
    ],
    "bundle": {
      "active": true,
      "targets": [
        "dmg"
      ],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns"
      ],
      "identifier": "ai.ollama.gui",
      "macOS": {
        "minimumSystemVersion": "10.15",
        "exceptionDomain": "",
        "frameworks": []
      }
    },
    "security": {
    "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' http://localhost:11434 https://cloud.ollama.ai http://localhost:* ws://localhost:* http: https: ws: wss:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; worker-src 'self' blob:; object-src 'none'; base-uri 'self'"
    },
    "updater": {
      "active": false
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {}
}

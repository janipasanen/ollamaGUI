{
  "$schema": "https://tauri.app/v1/schema.json",
  "package": {
    "version": "0.1.0"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": ["dmg"],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns"
      ],
      "identifier": "ai.ollama.gui",
      "macOS": {
        "minimumSystemVersion": "10.15",
        "exceptionDomain": "",
        "frameworks": []
      }
    },
    "security": {},
    "updater": {
      "active": false
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {}
}
